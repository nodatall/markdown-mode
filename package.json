{
  "name": "markdownmode",
  "version": "0.1.8",
  "description": "A local markdown review app",
  "license": "MIT",
  "author": "Nathan Baschez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lex-Inc/roughdraft.git"
  },
  "bin": {
    "markdownmode": "./packages/server/bin/markdownmode.mjs"
  },
  "scripts": {
    "setup": "./scripts/setup.sh",
    "start": "./scripts/run.sh",
    "dev": "node scripts/dev.mjs",
    "dev:install-cli": "node scripts/install-dev-cli.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "biome check . --assist-enabled=false",
    "lint:fix": "biome check --write . --assist-enabled=false",
    "test:selectors": "node scripts/check-test-selectors.mjs",
    "unused": "knip --no-progress",
    "format": "biome format --write .",
    "test": "corepack pnpm --filter @roughdraft/rfm test && corepack pnpm --filter @roughdraft/app test && corepack pnpm --filter @roughdraft/server test",
    "test:e2e": "playwright test --config packages/app/playwright.config.ts",
    "test:smoke": "playwright test --config packages/app/playwright.config.ts --grep @smoke",
    "test:coverage": "corepack pnpm --filter @roughdraft/app exec vitest run --coverage && corepack pnpm --filter @roughdraft/server exec vitest run --coverage",
    "check": "corepack pnpm lint && corepack pnpm test:selectors && corepack pnpm test && corepack pnpm build",
    "build": "corepack pnpm --filter @roughdraft/rfm build && corepack pnpm --filter @roughdraft/app build && corepack pnpm --filter @roughdraft/server build",
    "preview": "node packages/server/bin/markdownmode.mjs open README.md"
  },
  "files": [
    "packages/app/dist",
    "packages/rfm/dist",
    "packages/rfm/package.json",
    "packages/server/dist",
    "packages/server/bin",
    "packages/server/defaults.mjs",
    "packages/server/defaults.d.mts"
  ],
  "dependencies": {
    "@roughdraft/rfm": "file:packages/rfm",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.11.2",
    "@vitest/coverage-v8": "^4.1.5",
    "knip": "^6.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

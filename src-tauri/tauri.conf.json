{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Mode",
  "version": "0.1.8",
  "identifier": "com.local.markdownmode",
  "build": {
    "beforeDevCommand": "corepack pnpm --filter @roughdraft/app dev --host 127.0.0.1 --port 1421",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "corepack pnpm --filter @roughdraft/rfm build && corepack pnpm --filter @roughdraft/app build",
    "frontendDist": "../packages/app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Markdown Mode",
        "width": 1180,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "maximized": true,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**/*", "/Volumes/**/*", "/tmp/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ]
  }
}
